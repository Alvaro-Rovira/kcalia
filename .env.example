# Copia este fichero a .env y ajusta lo que necesites. .env NUNCA se sube al repositorio.

# --- Dominio ------------------------------------------------------------------
# Único sitio donde aparece el dominio. Para migrar a otro: cambia esta variable, pon el antiguo en
# REDIRECT_DOMAINS, apunta el DNS a la VPS y ejecuta deploy/caddy-site.sh (regenera el bloque de Caddy).
DOMAIN=kcalia.space
# Dominios que redirigen con 301 al principal (www, dominios antiguos), separados por espacios.
# HTTP siempre redirige a HTTPS. Los certificados de Let's Encrypt los pide y renueva Caddy.
REDIRECT_DOMAINS=www.kcalia.space
# Puerto local (solo loopback) al que llega el proxy. Debe estar libre en el servidor.
APP_PORT=8095
TZ=Europe/Madrid

# --- IA (cualquier proveedor compatible con OpenAI) -----------------------------
# Por defecto, Kimi K2.6 de Moonshot. Para cambiar de modelo basta con AI_MODEL
# (y AI_BASE_URL / AI_API_KEY si cambias de proveedor).
AI_BASE_URL=https://api.moonshot.ai/v1
# La clave NO se escribe a mano aquí: usa scripts/set-ai-key.sh, que la pide sin mostrarla.
AI_API_KEY=
AI_MODEL=kimi-k2.6
# Modelo para las fotos. Vacío = usa AI_MODEL (Kimi K2.6 acepta imágenes).
AI_VISION_MODEL=
# Solo si quieres OTRO proveedor para las fotos (vacías = el mismo que para el texto).
# AI_VISION_BASE_URL=
# AI_VISION_API_KEY=
# Tope GLOBAL de consultas de IA (texto + foto) al día, sumando todas las cuentas: protege de gastos inesperados.
AI_DAILY_LIMIT=60
# Tope por cuenta y día (el administrador puede cambiarlo a cada cuenta desde /admin).
AI_USER_DAILY_LIMIT=20
# Tope propio del administrador, aparte del global: lo que gasten los demás no le bloquea. 0 = igual que AI_DAILY_LIMIT.
ADMIN_AI_DAILY_LIMIT=0
AI_TIMEOUT=45
# Precio del modelo en dólares por millón de tokens (entrada / salida), para estimar el gasto en /admin.
AI_PRICE_INPUT=0.95
AI_PRICE_OUTPUT=4.00

# --- Voz (transcripción) ---------------------------------------------------------
# Whisper propio en un contenedor (coste 0 €). Modelos: tiny, base, small, medium.
# `small` es un buen equilibrio entre español correcto y velocidad en CPU.
WHISPER_MODEL=small
WHISPER_THREADS=3
STT_DAILY_LIMIT=100
STT_USER_DAILY_LIMIT=30
# Coste estimado de cada audio en dólares (0 con el Whisper propio).
STT_PRICE_PER_CALL=0
# Para usar un servicio externo compatible con OpenAI en lugar del contenedor:
# STT_BASE_URL=https://api.openai.com/v1
# STT_API_KEY=
# STT_MODEL=whisper-1

# --- Sesión y copias -------------------------------------------------------------
# Compresión desde la propia app: solo si NO hay proxy delante (Caddy ya comprime, mejor).
# GZIP=false
# La cookie de sesión exige HTTPS. Ponlo a false SOLO para probar en http://localhost.
# COOKIE_SECURE=true
# Días que dura la sesión (se renueva con el uso).
SESSION_DAYS=180
# Copias diarias de la base de datos que se conservan.
BACKUP_KEEP=7

# --- Cuentas ---------------------------------------------------------------------
# La primera cuenta que se crea es la del administrador. Las demás quedan pendientes hasta que las apruebe en /admin.
# false = nadie puede pedir cuenta (el administrador también puede cerrar el registro desde /admin).
ALLOW_SIGNUP=true
# Máximo de solicitudes pendientes a la vez (frena el registro masivo).
MAX_PENDING_ACCOUNTS=20

# --- Notificaciones (Web Push) -----------------------------------------------------
# Recordatorios y avisos de nuevas solicitudes. Se generan SIN mostrarse con:
#   python3 scripts/gen-vapid.py --env-file .env
# Vacías = sin notificaciones (la app funciona igual). No las cambies después: invalidaría las suscripciones.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# Contacto para los servicios de push (mailto: o https:). Vacío = https://DOMAIN.
VAPID_SUBJECT=

# --- Sugerencias ---------------------------------------------------------------------
# A partir de cuántas calorías restantes se sugiere qué comer para cerrar el día (cada cuenta puede cambiarlo).
SUGGEST_MIN_KCAL=80

# --- Copia fuera del servidor (opcional) ---------------------------------------------
# Cualquier almacenamiento compatible con S3: Cloudflare R2, Backblaze B2, AWS S3, MinIO...
# Vacío = solo la copia local diaria. El estado de la última subida se ve en /admin.
BACKUP_REMOTE_URL=
BACKUP_REMOTE_BUCKET=
BACKUP_REMOTE_PREFIX=kcalia/
BACKUP_REMOTE_REGION=auto
BACKUP_REMOTE_ACCESS_KEY=
BACKUP_REMOTE_SECRET_KEY=
# Copias que se conservan en el destino.
BACKUP_REMOTE_KEEP=30
# Frase para cifrar las copias externas (AES-256-GCM). Guárdala aparte: sin ella no se pueden restaurar.
# Se descifran con scripts/restore-backup.py.
BACKUP_ENCRYPTION_KEY=
